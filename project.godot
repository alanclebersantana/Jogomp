; Milhas Plus – Cadê as milhas?! — corrida contra o embarque (Godot 4.6)
config_version=5

[application]

config/name="Milhas Plus – Cadê as milhas?!"
config/description="O robô Milis corre pelos aeroportos para recuperar as milhas roubadas pelo Barão das Milhas Falsas antes do portão fechar."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.07, 0.1, 0.16, 1)
boot_splash/show_image=false
config/icon="res://icon.png"
config/quit_on_go_back=false
run/max_fps=0

[autoload]

Arte="*res://scripts/arte.gd"
Save="*res://scripts/save.gd"
Som="*res://scripts/som.gd"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=1
2d/snap/snap_2d_transforms_to_pixel=false
