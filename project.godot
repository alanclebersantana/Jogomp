; Encontre-a — projeto Godot 4.6
config_version=5

[application]

run/max_fps=0

config/name="Encontre-a"
config/description="Um pai, uma lanterna e uma trilha de lápis de cor."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.043, 0.035, 0.024, 1)
boot_splash/show_image=false
config/icon="res://icon.png"
config/quit_on_go_back=false

[autoload]

Save="*res://scripts/save.gd"
Spr="*res://scripts/spr.gd"
Audio="*res://scripts/audio.gd"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=3

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=false
