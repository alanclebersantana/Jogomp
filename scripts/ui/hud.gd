	Spr.rr(x - 1, y + 2, w + 2, h + 2, 9, Color(0, 0, 0, .3 * a))
	Spr.rr(x, y, w, h, 8, Color("#13244a", .97 * a))
	Spr.rr(x + 2, y + 5, w - 4, h - 9, 6, Color("#f7f1e3", .97 * a))
	Spr.rr(x + 4, y + 6, w - 8, 4, 2, Color(1, 1, 1, .35 * a))
	# picote do canhoto (à direita)
	var px: float = x + w * .8
	var yy: float = y + 7
	while yy < y + h - 6:
		Spr.rect(px, yy, 1.5, 3, Color("#13244a", .55 * a))
		yy += 6
	Spr.circle(px + .75, y + 2, 3.5, Color(0, 0, 0, .0))

