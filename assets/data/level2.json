 "hints": [
  {
   "a": 0,
   "b": 700,
   "t": "Episódio 2 · A boca da mina. Siga os lápis da Isis pelos trilhos. A lanterna clareia o caminho: pegue o óleo pelo caminho."
  },
  {
   "a": 1300,
   "b": 1500,
   "t": "Cavaletes sobre o poço: pule de tábua em tábua. Cuidado com o morcego!"
  },
  {
   "a": 2850,
   "b": 3110,
   "t": "Porta de manivela: aperte USAR várias vezes seguidas para girar e a porta sobe."
  },
  {
   "a": 3420,
   "b": 3760,
   "t": "Empurre a caixa até o buraco da placa: o portão de ferro sobe."
  },
  {
   "a": 4100,
   "b": 4380,
   "t": "Elevador da mina: suba na gaiola e aperte USAR."
  },
  {
   "a": 5700,
   "b": 5900,
   "t": "Lago de veneno! Pule e mergulhe (↓ no ar) em cima da estaca: a ponte desce."
  },
  {
   "a": 8700,
   "b": 9000,
   "t": "Duas alavancas: puxe as duas (USAR) para o portão subir."
  },
  {
   "a": 9800,
   "b": 10300,
   "t": "O vale do moinho. Lá longe, um moinho velho com as velas rasgadas..."
  },
  {
   "a": 11380,
   "b": 11520,
   "t": "O celeiro tem a porta baixa: segure ↓ para entrar abaixado."
  },
  {
   "a": 13250,
   "b": 13650,
   "t": "As tábuas presas nas pás do moinho só giram se ele tiver velas. Junte a lona com a corda na mochila."
  },
  {
   "a": 13960,
   "b": 14200,
   "t": "Pule da tábua para o alto do barranco quando ela passar perto!",
   "yl": -100
  },
  {
   "a": 14150,
   "b": 14450,
   "t": "Uma cancela fechada... e uma placa no chão. Empurre o caixote até a placa para segurar a cancela aberta.",
   "yl": -100
  },
  {
   "a": 14600,
   "b": 14720,
   "t": "Lago fundo! Lá embaixo, na prateleira de pedra, o velho equipamento de mergulho do moinheiro. E lá na frente... colmeias penduradas sobre as vitórias-régias.",
   "yl": -120
  },
  {
   "a": 16820,
   "b": 17300,
   "t": "Vigias e cães de guarda andam pela rua. Fique lá em cima: de telhado em telhado!",
   "yl": 100
  },
  {
   "a": 18550,
   "b": 18730,
   "t": "Telhas soltas! Elas despencam logo depois que você pisa: não pare.",
   "yl": -150
  },
  {
   "a": 19038,
   "b": 19426,
   "t": "A casa ao lado é alta demais: pule no toldo de pano e ele joga você para cima!",
   "yl": -150
  },
  {
   "a": 20044,
   "b": 20207,
   "t": "Telhas soltas no meio do telhado! Se pisar, elas despencam e você cai na rua. Pule por cima.",
   "yl": -150
  },
  {
   "a": 20870,
   "b": 21030,
   "t": "Esgoto lá embaixo! Pule no varal e ande pendurado; PULAR dá impulso para subir.",
   "yl": -150
  },
  {
   "a": 18425,
   "b": 18624,
   "t": "Chaminé quente: não pise nela! Pule por cima (pulo duplo) — a fumaça ajuda a planar.",
   "yl": -150
  },
  {
   "a": 22986,
   "b": 23186,
   "t": "O quintal do vigia-chefe... e o cachorro dele, preso numa corrente. Prenda a corrente nas argolas do chão para ele não alcançar o portão!"
  },
  {
   "a": 24186,
   "b": 24496,
   "t": "A porteira da mina: junte as duas metades da chave na mochila."
  },
  {
   "a": 25166,
   "b": 25406,
   "t": "Uma caverna enorme e escura... algo grande dorme pendurado lá no alto. Ali tem lamparinas apagadas."
  },
  {
   "a": 26326,
   "b": 26686,
   "t": "Um carrinho de mina! Chegue nele para subir e ir atrás do Vargas."
  },
  {
   "a": 28126,
   "b": 28726,
   "t": "A porta de ferro do Vargas... Pegue a pista e vá até a porta."
  },
  {
   "a": 30626,
   "b": 30906,
   "t": "Uma fresta embaixo da parede! A Isis é pequena: ela cabe. Vá para a direita.",
   "yl": 200
  },
  {
   "a": 31126,
   "b": 31406,
   "t": "Um vigia da vila aqui embaixo! O Vargas pagou os vigias com o ouro roubado. Quando a luz vier, segure ↓ atrás de um caixote ou barril: escondida, ele não vê.",
   "yl": 200
  },
  {
   "a": 31986,
   "b": 32246,
   "t": "Alto demais para a Isis! Empurre o caixote até a parede e suba nele.",
   "yl": 200
  },
  {
   "a": 32486,
   "b": 32576,
   "t": "Tábuas podres! Elas despencam logo depois que você pisa: pule de uma para a outra sem parar.",
   "yl": 200
  },
  {
   "a": 33126,
   "b": 33226,
   "t": "Espere a tábua chegar e pule nela.",
   "yl": 200
  },
  {
   "a": 33786,
   "b": 33926,
   "t": "Uma corda esticada: pule nela e vá pendurada até o outro lado.",
   "yl": 200
  },
  {
   "a": 34606,
   "b": 34746,
   "t": "Um túnel bem baixinho: segure ↓ e passe engatinhando.",
   "yl": 200
  },
  {
   "a": 35326,
   "b": 35526,
   "t": "Suba nas prateleiras: lá em cima a luz do lampião não chega. Cuidado com a prateleira podre!",
